{
  "name": "io.ossia.ossia-unity",
  "displayName": "ossia (PRISM)",
  "version": "@OSSIA_UNITY_VERSION@",
  "unity": "2018.3",
  "description": "OSSIA library, version @GIT_TAG@ (latest commit @GIT_SHA@ on @GIT_DATE@)",
  "keywords": [ "osc", "oscquery", "remote", "control" ],
  "category": "network",
  "dependencies": {
  },
  "samples": [
    {
      "displayName": "Exposed cube",
      "description": "An OssiaController and a cube whose transform is exposed over OSCQuery, on ports 1234 (OSC) and 5678 (HTTP and WebSocket).",
      "path": "Samples~/ExposedCube"
    },
    {
      "displayName": "Custom parameters",
      "description": "A script whose own fields (float, int, bool, Color, Vector3) are marked [Ossia.Expose] and exposed under /Shape/CustomParameters, with the Max patch CustomParameters.maxpat that drives and follows them.",
      "path": "Samples~/CustomParameters"
    },
    {
      "displayName": "Follow a device",
      "description": "An Ossia.Client and a cube whose Ossia.Remote components follow follow_me, the device the Max patch FollowADevice.maxpat exposes: Max sets the cube's size, color and spin, Unity sends its angle back.",
      "path": "Samples~/FollowADevice"
    }
  ]
}
